<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Extend stock.location form with WMS fields -->
        <record id="view_stock_location_form_wms" model="ir.ui.view">
            <field name="name">stock.location.form.wms</field>
            <field name="model">stock.location</field>
            <field name="inherit_id" ref="stock.view_location_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet/group" position="inside">
                    <group string="WMS hierarchy">
                        <field name="wms_location_type"/>
                        <field name="wms_rack_code"
                               invisible="wms_location_type != 'rack'"/>
                        <field name="wms_shelf_count"
                               invisible="wms_location_type != 'rack'"/>
                        <field name="wms_column_count"
                               invisible="wms_location_type != 'rack'"/>
                        <field name="wms_shelf_top"
                               invisible="wms_location_type != 'compartment'"/>
                        <field name="wms_shelf_bottom"
                               invisible="wms_location_type != 'compartment'"/>
                        <field name="wms_column_left"
                               invisible="wms_location_type != 'compartment'"/>
                        <field name="wms_column_right"
                               invisible="wms_location_type != 'compartment'"/>
                        <field name="wms_slot_count"
                               invisible="wms_location_type != 'compartment'"/>
                        <field name="wms_slot_number"
                               invisible="wms_location_type != 'slot'"/>
                        <field name="wms_capacity_units"
                               invisible="wms_location_type != 'slot'"/>
                        <field name="wms_current_qty"
                               invisible="wms_location_type not in ('slot','compartment','rack')"/>
                        <field name="wms_occupancy_pct" widget="percentage"
                               invisible="wms_location_type != 'slot' or wms_capacity_units == 0"/>
                        <field name="wms_product_ids" widget="many2many_tags"
                               invisible="wms_location_type != 'slot'"/>
                    </group>
                </xpath>
            </field>
        </record>

        <!-- Slot list -->
        <record id="view_wms_slot_tree" model="ir.ui.view">
            <field name="name">wms.slot.tree</field>
            <field name="model">stock.location</field>
            <field name="arch" type="xml">
                <list string="Slots">
                    <field name="complete_name" string="Slot"/>
                    <field name="barcode"/>
                    <field name="wms_slot_number"/>
                    <field name="wms_capacity_units"/>
                    <field name="wms_current_qty"/>
                    <field name="wms_occupancy_pct" widget="percentage"/>
                    <field name="wms_product_ids" widget="many2many_tags"/>
                </list>
            </field>
        </record>

        <!-- Slot kanban — quick visual occupancy -->
        <record id="view_wms_slot_kanban" model="ir.ui.view">
            <field name="name">wms.slot.kanban</field>
            <field name="model">stock.location</field>
            <field name="arch" type="xml">
                <kanban default_group_by="location_id" class="o_kanban_small_column">
                    <field name="wms_current_qty"/>
                    <field name="wms_capacity_units"/>
                    <field name="wms_product_ids"/>
                    <field name="barcode"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_card">
                                <strong><field name="complete_name"/></strong>
                                <div>Barcode: <field name="barcode"/></div>
                                <div>Qty: <field name="wms_current_qty"/>
                                     <span t-if="record.wms_capacity_units.raw_value">
                                       / <field name="wms_capacity_units"/>
                                     </span>
                                </div>
                                <div><field name="wms_product_ids" widget="many2many_tags"/></div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="view_wms_slot_search" model="ir.ui.view">
            <field name="name">wms.slot.search</field>
            <field name="model">stock.location</field>
            <field name="arch" type="xml">
                <search>
                    <field name="complete_name"/>
                    <field name="barcode"/>
                    <filter name="group_rack" string="Group by Compartment"
                            context="{'group_by': 'location_id'}"/>
                </search>
            </field>
        </record>

        <record id="action_wms_slots" model="ir.actions.act_window">
            <field name="name">Slots</field>
            <field name="res_model">stock.location</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="domain">[('wms_location_type', '=', 'slot')]</field>
            <field name="search_view_id" ref="view_wms_slot_search"/>
            <field name="context">{'search_default_group_rack': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">This is your storage map.</p>
                <p>
                    Each slot is one shelf space where stock lives. To bring stock
                    <b>IN</b>, use <b>Scan Receipt</b>; to take stock <b>OUT</b>, use
                    <b>Scan Issue</b> &#8212; both just below in this <b>Operations</b> menu.
                </p>
                <p>
                    No slots yet? A manager creates them under
                    <b>Configuration &#8594; Generate Zone / Create Rack</b>.
                    New here? Open <b>Help &amp; Training &#8594; Getting Started</b>.
                </p>
            </field>
        </record>

        <record id="action_wms_racks" model="ir.actions.act_window">
            <field name="name">Racks</field>
            <field name="res_model">stock.location</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('wms_location_type', '=', 'rack')]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">No racks yet.</p>
                <p>
                    A rack is a shelving unit that holds compartments and slots.
                    Managers create racks from <b>Configuration &#8594; Create Rack</b>.
                </p>
            </field>
        </record>

        <record id="action_wms_compartments" model="ir.actions.act_window">
            <field name="name">Compartments</field>
            <field name="res_model">stock.location</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('wms_location_type', '=', 'compartment')]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">No compartments yet.</p>
                <p>
                    A compartment is a section of a rack that groups slots.
                    Managers create these along with racks from
                    <b>Configuration &#8594; Create Rack</b>.
                </p>
            </field>
        </record>

    </data>
</odoo>
