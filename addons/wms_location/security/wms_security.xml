<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_wms" model="ir.module.category">
            <field name="name">Warehouse Management</field>
            <field name="description">Rack/Divider/Slot WMS</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_wms_user" model="res.groups">
            <field name="name">WMS / User</field>
            <field name="category_id" ref="module_category_wms"/>
            <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        </record>

        <record id="group_wms_manager" model="res.groups">
            <field name="name">WMS / Manager</field>
            <field name="category_id" ref="module_category_wms"/>
            <field name="implied_ids" eval="[(4, ref('stock.group_stock_manager')), (4, ref('group_wms_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>
