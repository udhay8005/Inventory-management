<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Two-role security model
        =======================
          • WMS / Manager      (= Admin)        full control: add/edit/delete
                                                products, locations, racks,
                                                zones; runs cycle counts;
                                                approves damage; everything.
                                                The built-in `admin` user is
                                                added to this group on first
                                                install.
          • WMS / Store Keeper (= operator)     scan-receipt / scan-issue /
                                                damage-entry only. Cannot add,
                                                edit, or delete products or
                                                locations. Reads every report
                                                (for weekly audits) but cannot
                                                modify the underlying data.

        Repair Tech and Buyer are optional sub-roles defined in the
        wms_repair_damage and wms_ai_forecast addons. They start empty;
        the Admin assigns users to them only if those workflows are needed.
    -->
    <data noupdate="0">

        <record id="module_category_wms" model="ir.module.category">
            <field name="name">Warehouse Management</field>
            <field name="description">Rack / Compartment / Slot WMS</field>
            <field name="sequence">20</field>
        </record>

        <!--
            "Store Keeper" is the every-day operator. XML id stays
            group_wms_user to keep the dozens of CSV ACL references
            elsewhere in the project working without churn.
        -->
        <record id="group_wms_user" model="res.groups">
            <field name="name">WMS / Store Keeper</field>
            <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        </record>

        <!--
            ============================================================
            Per-keeper capability sub-groups
            ============================================================

            Each sub-group is a single tickable "advantage" the Admin
            grants to a Store Keeper from the roster form. Each implies
            group_wms_user so the holder always has the read-only
            baseline (login + see WMS + read inventory).

            Menus and ACL rows are gated by these sub-groups - a user
            with group_wms_user alone (no sub-groups) can log in and
            browse, but the Scan Receipt menu / Damage form / Audit
            list never appear.

            The Manager group below implies all five so the Admin sees
            everything by default.
        -->

        <record id="group_wms_can_scan_receive" model="res.groups">
            <field name="name">WMS / Capability: Scan Receipt + Scan Return</field>
            <field name="implied_ids" eval="[(4, ref('group_wms_user'))]"/>
        </record>

        <record id="group_wms_can_scan_issue" model="res.groups">
            <field name="name">WMS / Capability: Scan Issue (outbound)</field>
            <field name="implied_ids" eval="[(4, ref('group_wms_user'))]"/>
        </record>

        <record id="group_wms_can_file_damage" model="res.groups">
            <field name="name">WMS / Capability: File damage events</field>
            <field name="implied_ids" eval="[(4, ref('group_wms_user'))]"/>
        </record>

        <record id="group_wms_can_submit_audit" model="res.groups">
            <field name="name">WMS / Capability: Submit inventory audits</field>
            <field name="implied_ids" eval="[(4, ref('group_wms_user'))]"/>
        </record>

        <record id="group_wms_can_manage_catalog" model="res.groups">
            <field name="name">WMS / Capability: Manage carton aliases + labels</field>
            <field name="implied_ids" eval="[(4, ref('group_wms_user'))]"/>
        </record>

        <!--
            Manager - declared AFTER the capability groups so its
            implied_ids can reference them. Admin user is added here
            in a single record. The capability sub-groups are
            included via implied_ids so the Admin auto-inherits
            every capability + the base group_wms_user role.
        -->
        <record id="group_wms_manager" model="res.groups">
            <field name="name">WMS / Manager</field>
            <field name="implied_ids" eval="[
                (4, ref('stock.group_stock_manager')),
                (4, ref('group_wms_user')),
                (4, ref('group_wms_can_scan_receive')),
                (4, ref('group_wms_can_scan_issue')),
                (4, ref('group_wms_can_file_damage')),
                (4, ref('group_wms_can_submit_audit')),
                (4, ref('group_wms_can_manage_catalog')),
            ]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <!--
            Backward compatibility: anyone currently in group_wms_user
            (the legacy "Store Keeper" baseline role) gets all five
            capability sub-groups added so they keep their existing
            menus after upgrade. Without this, a pre-existing
            storekeeper user would lose Scan / Damage / Audit access
            until an Admin re-ticks the boxes.

            Idempotent: the underlying method only ADDS missing
            group memberships - re-running on already-granted users
            is a no-op.
        -->
        <function model="res.users" name="_wms_backfill_capabilities"/>

        <!--
            Hide Odoo's built-in Inventory app from Store Keepers.

            Store Keepers must keep stock.group_stock_user so the WMS
            wizards (Scan Receipt / Scan Issue / Damage) can create
            stock.pickings programmatically. But seeing the Inventory app
            menu gives them a back-door to create pickings WITHOUT going
            through Scan Receipt — bypassing the QC checkbox, the
            on-duty Store Keeper roster, and the audit chatter.

            Restricting the root menu to stock.group_stock_manager hides
            the whole app from Store Keepers (they're only in
            stock.group_stock_user via group_wms_user). Managers still
            see it because group_wms_manager implies
            stock.group_stock_manager.

            Net effect: the trust's WMS workflows become the only path
            for a Store Keeper to move stock — exactly as designed.
        -->
        <record id="stock.menu_stock_root" model="ir.ui.menu">
            <field name="group_ids" eval="[(6, 0, [ref('stock.group_stock_manager')])]"/>
        </record>

        <!--
            Same idea for the other top-level Odoo apps that creep into
            the Storekeeper's app picker out-of-the-box: Apps and
            Dashboards. The Storekeeper has no business installing
            modules or building spreadsheet dashboards — both are
            Admin-only tools. Restrict to group_wms_manager (which the
            Admin role implies) so the app picker shows only Discuss +
            WMS for an on-duty keeper. Invoicing / Purchase / Settings
            / Inventory are already hidden via their own default
            groups; this pair was the gap.
        -->
        <record id="base.menu_management" model="ir.ui.menu">
            <field name="group_ids" eval="[(6, 0, [ref('wms_location.group_wms_manager')])]"/>
        </record>
        <record id="spreadsheet_dashboard.spreadsheet_dashboard_menu_root" model="ir.ui.menu">
            <field name="group_ids" eval="[(6, 0, [ref('wms_location.group_wms_manager')])]"/>
        </record>

    </data>
</odoo>
