<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="wms_location.RackBuilder">
        <div class="o_wms_rack_builder">

            <div class="o_wms_rack_builder__controls">
                <label class="me-1">Shelves:</label>
                <input
                    type="number"
                    min="1"
                    max="30"
                    class="form-control form-control-sm me-3"
                    style="width: 70px;"
                    t-att-value="state.shelves"
                    t-on-change="(ev) => this.onShelvesChange(ev)"/>

                <label class="me-1">Columns:</label>
                <input
                    type="number"
                    min="1"
                    max="20"
                    class="form-control form-control-sm me-3"
                    style="width: 70px;"
                    t-att-value="state.columns"
                    t-on-change="(ev) => this.onColumnsChange(ev)"/>

                <button class="btn btn-sm btn-outline-secondary" t-on-click="() => this.resetGrid()">
                    Reset grid
                </button>
            </div>

            <div class="o_wms_rack_builder__layout">

                <!--
                    One DOM element per grid cell (shelf, column). Cells
                    belonging to the same compartment share the
                    `selected` highlight, and the interior borders are
                    hidden via the borderTop/borderBottom/borderLeft/
                    borderRight flags on the cell object - the visual
                    effect is a single outlined polyomino regardless of
                    its shape.
                -->
                <div class="o_wms_rack_builder__grid" t-att-style="gridStyle()">
                    <t t-foreach="gridCells" t-as="cell" t-key="cell.shelf + '_' + cell.column">
                        <div
                            class="o_wms_rack_builder__cell"
                            t-att-class="{
                                'o_wms_rack_builder__cell--selected': cell.selected,
                                'o_wms_rack_builder__cell--multi':    cell.multiCell,
                                'o_wms_rack_builder__cell--no-top':    !cell.borderTop,
                                'o_wms_rack_builder__cell--no-bottom': !cell.borderBottom,
                                'o_wms_rack_builder__cell--no-left':   !cell.borderLeft,
                                'o_wms_rack_builder__cell--no-right':  !cell.borderRight,
                                'o_wms_rack_builder__cell--addable':
                                    state.addCellMode and cell.compartmentId !== state.selectedId,
                            }"
                            t-att-style="cellStyle(cell)"
                            t-on-click="() => this.onCellClick(cell.shelf, cell.column)">
                            <t t-if="cell.isAnchor">
                                <div class="o_wms_rack_builder__cell-label" t-esc="cell.label"/>
                                <div class="o_wms_rack_builder__cell-slots" t-if="cell.slotBadge"
                                     t-esc="cell.slotBadge"/>
                            </t>
                        </div>
                    </t>
                </div>

                <div class="o_wms_rack_builder__panel">
                    <t t-if="selectedCompartment">
                        <div class="o_wms_rack_builder__panel-title">
                            Selected: <strong t-esc="compartmentLabel(selectedCompartment)"/>
                        </div>

                        <div class="o_wms_rack_builder__panel-section">
                            <div class="o_wms_rack_builder__panel-label">Merge with neighbour (rectangle)</div>
                            <div class="o_wms_rack_builder__dpad">
                                <button class="btn btn-sm btn-outline-primary o_wms_rack_builder__dpad-up"
                                        t-att-disabled="!canMergeUp()"
                                        t-on-click="() => this.mergeUp()"
                                        title="Extend up — works only on rectangular compartments">↑</button>
                                <button class="btn btn-sm btn-outline-primary o_wms_rack_builder__dpad-left"
                                        t-att-disabled="!canMergeLeft()"
                                        t-on-click="() => this.mergeLeft()"
                                        title="Extend left — works only on rectangular compartments">←</button>
                                <button class="btn btn-sm btn-outline-warning o_wms_rack_builder__dpad-center"
                                        t-att-disabled="!canSplit()"
                                        t-on-click="() => this.split()"
                                        title="Split back into single cells">Split</button>
                                <button class="btn btn-sm btn-outline-primary o_wms_rack_builder__dpad-right"
                                        t-att-disabled="!canMergeRight()"
                                        t-on-click="() => this.mergeRight()"
                                        title="Extend right — works only on rectangular compartments">→</button>
                                <button class="btn btn-sm btn-outline-primary o_wms_rack_builder__dpad-down"
                                        t-att-disabled="!canMergeDown()"
                                        t-on-click="() => this.mergeDown()"
                                        title="Extend down — works only on rectangular compartments">↓</button>
                            </div>
                        </div>

                        <!--
                            New: free-shape merge. Toggle the button on,
                            then click any 4-adjacent cell to add it to
                            the selected compartment. Build L / T / U
                            shapes one cell at a time.
                        -->
                        <div class="o_wms_rack_builder__panel-section">
                            <div class="o_wms_rack_builder__panel-label">Free-shape (L / T / U etc.)</div>
                            <button class="btn btn-sm w-100"
                                    t-att-class="state.addCellMode ? 'btn-success' : 'btn-outline-success'"
                                    t-on-click="() => this.toggleAddCellMode()">
                                <t t-if="state.addCellMode">✓ Click adjacent cells to add</t>
                                <t t-else="">+ Add adjacent cell</t>
                            </button>
                            <div class="text-muted small mt-2" t-if="state.addCellMode">
                                Click any cell that touches the selected
                                compartment (edge-adjacent). It joins
                                immediately. Click the button again to stop.
                            </div>
                        </div>

                        <div class="o_wms_rack_builder__panel-section">
                            <div class="o_wms_rack_builder__panel-label">Slots inside this compartment</div>
                            <div class="o_wms_rack_builder__slot-controls">
                                <button class="btn btn-sm btn-light"
                                        t-att-disabled="selectedCompartment.slot_count &lt;= 1"
                                        t-on-click="() => this.decrementSlots()">−</button>
                                <span class="o_wms_rack_builder__slot-count" t-esc="selectedCompartment.slot_count"/>
                                <button class="btn btn-sm btn-light"
                                        t-on-click="() => this.incrementSlots()">+</button>
                            </div>
                        </div>
                    </t>
                    <t t-else="">
                        <p class="text-muted">Click a compartment in the grid to edit it.</p>
                        <ul class="text-muted small">
                            <li><b>Merge ↑/↓/←/→</b> grows a rectangular compartment one row/column at a time.</li>
                            <li><b>+ Add adjacent cell</b> grows the compartment into any L / T / U shape, one cell per click.</li>
                            <li><b>Split</b> breaks any multi-cell compartment back into single cells.</li>
                            <li><b>Slots</b> sub-divides the compartment into N storable positions.</li>
                        </ul>
                    </t>
                </div>

            </div>
        </div>
    </t>

</templates>
