            <field name="padding">5</field>
        </record>

        <record id="seq_sku_wip" model="ir.sequence">
            <field name="name">WMS SKU - Work in Progress</field>
            <field name="code">wms.sku.wip</field>
            <field name="prefix">WIP-</field>
            <field name="padding">5</field>
        </record>

        <record id="seq_sku_consumable" model="ir.sequence">
            <field name="name">WMS SKU - Consumable</field>
            <field name="code">wms.sku.consumable</field>
            <field name="prefix">CONS-</field>
            <field name="padding">5</field>
        </record>

        <record id="seq_sku_tool" model="ir.sequence">
            <field name="name">WMS SKU - Tool / Equipment</field>
            <field name="code">wms.sku.tool</field>
            <field name="prefix">TOOL-</field>
            <field name="padding">5</field>
