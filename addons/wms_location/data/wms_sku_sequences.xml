            <field name="code">wms.sku.spare</field>
            <field name="prefix">SPARE-</field>
            <field name="padding">5</field>
        </record>

        <!--
            Trust-specific SKU sequences. Order matches the entries
            added in WMS_KIND_SELECTION inside
            models/product_template.py. To add another kind later:
              1. Append entry to WMS_KIND_SELECTION + the four dicts
                 in product_template.py.
              2. Append a matching <record> block below.
              3. Restart Odoo with `-u wms_location`.
        -->
        <record id="seq_sku_medicine" model="ir.sequence">
            <field name="name">WMS SKU - Medicine (veterinary)</field>
            <field name="code">wms.sku.medicine</field>
            <field name="prefix">MED-</field>
            <field name="padding">5</field>
        </record>

        <record id="seq_sku_feed" model="ir.sequence">
            <field name="name">WMS SKU - Feed / Grass / Bran</field>
