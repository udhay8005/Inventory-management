<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Seed the trust's departments / cost centres. noupdate="1" so a
            re-install / upgrade never clobbers an admin's edits or
            re-creates archived rows. `legacy_issued_for` maps each old
            WMS_ISSUED_FOR_SELECTION code (cows / pooja / maintenance /
            project / administration / other) to exactly one seeded
            department; the wms_barcode back-fill migration reads it to
            populate wms_department_id on historical pickings. The finer
            new departments (vet, dairy, fodder, R&D, kitchen) carry a
            blank legacy code — they have no old data to inherit.

            dept_other is the wizard default (wms_location.dept_other) and
            must always exist so Scan Issue is never blocked.
        -->
        <record id="dept_gaushala" model="wms.department">
            <field name="name">Gaushala / Cowshed</field>
            <field name="code">GAU</field>
            <field name="legacy_issued_for">cows</field>
            <field name="sequence">10</field>
        </record>
        <record id="dept_vet_hospital" model="wms.department">
            <field name="name">Veterinary Hospital</field>
            <field name="code">VET</field>
            <field name="legacy_issued_for"></field>
            <field name="sequence">20</field>
        </record>
        <record id="dept_rnd" model="wms.department">
            <field name="name">R&amp;D / Panchgavya</field>
            <field name="code">RND</field>
            <field name="legacy_issued_for"></field>
            <field name="sequence">30</field>
        </record>
        <record id="dept_dairy" model="wms.department">
            <field name="name">Dairy</field>
            <field name="code">DRY</field>
            <field name="legacy_issued_for"></field>
            <field name="sequence">40</field>
        </record>
        <record id="dept_fodder" model="wms.department">
            <field name="name">Fodder &amp; Agriculture</field>
            <field name="code">FOD</field>
            <field name="legacy_issued_for"></field>
            <field name="sequence">50</field>
        </record>
        <record id="dept_kitchen" model="wms.department">
            <field name="name">Kitchen / Bhojanalaya</field>
            <field name="code">KIT</field>
            <field name="legacy_issued_for"></field>
            <field name="sequence">60</field>
        </record>
        <record id="dept_maintenance" model="wms.department">
            <field name="name">Maintenance / Repairs</field>
            <field name="code">MNT</field>
            <field name="legacy_issued_for">maintenance</field>
            <field name="sequence">70</field>
        </record>
        <record id="dept_project" model="wms.department">
            <field name="name">Construction / Project</field>
            <field name="code">PRJ</field>
            <field name="legacy_issued_for">project</field>
            <field name="sequence">80</field>
        </record>
        <record id="dept_admin" model="wms.department">
            <field name="name">Administration / Office</field>
            <field name="code">ADM</field>
            <field name="legacy_issued_for">administration</field>
            <field name="sequence">90</field>
        </record>
        <record id="dept_temple" model="wms.department">
            <field name="name">Temple / Pooja</field>
            <field name="code">TMP</field>
            <field name="legacy_issued_for">pooja</field>
            <field name="sequence">100</field>
        </record>
        <record id="dept_other" model="wms.department">
            <field name="name">Other</field>
            <field name="code">OTH</field>
            <field name="legacy_issued_for">other</field>
            <field name="sequence">110</field>
        </record>

        <!--
            Starter purpose list. Optional dimension on an issue; admin can
            add / archive freely.
        -->
        <record id="purpose_consumption" model="wms.purpose">
            <field name="name">Routine consumption</field>
            <field name="sequence">10</field>
        </record>
        <record id="purpose_treatment" model="wms.purpose">
            <field name="name">Animal treatment</field>
            <field name="sequence">20</field>
        </record>
        <record id="purpose_vaccination" model="wms.purpose">
            <field name="name">Vaccination / deworming</field>
            <field name="sequence">30</field>
        </record>
        <record id="purpose_maintenance" model="wms.purpose">
            <field name="name">Maintenance / repair</field>
            <field name="sequence">40</field>
        </record>
        <record id="purpose_research" model="wms.purpose">
            <field name="name">Research / Panchgavya</field>
            <field name="sequence">50</field>
        </record>
        <record id="purpose_other" model="wms.purpose">
            <field name="name">Other</field>
            <field name="sequence">60</field>
        </record>
    </data>
</odoo>
