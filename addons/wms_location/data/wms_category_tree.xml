<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Generic enterprise category tree with gaushala presets. This file
            ONLY CREATES new product.category records — it writes categ_id on
            NO existing product, so seeding can never reparent or move any
            item already in the catalogue (the additive invariant). noupdate="1"
            so the admin can freely rename / move / archive / extend the tree
            afterwards without an upgrade undoing it.

            Each LEAF carries wms_default_kind (so the creation wizard always
            resolves a WMS kind -> SKU prefix / unit / lifecycle) plus the
            owner's per-category required-identity flags. Those flags are INERT
            until P3 wires enforcement; they are seeded as sensible defaults the
            admin tunes. Branch nodes are organisational (products live on the
            leaves).
        -->

        <!-- ============ Animal Care ============ -->
        <record id="cat_animal_care" model="product.category">
            <field name="name">Animal Care</field>
        </record>
        <record id="cat_medicines" model="product.category">
            <field name="name">Medicines</field>
            <field name="parent_id" ref="cat_animal_care"/>
            <field name="wms_default_kind">medicine</field>
            <field name="wms_req_brand">True</field>
            <field name="wms_req_form">True</field>
            <field name="wms_req_strength">True</field>
            <field name="wms_req_size">True</field>
            <field name="wms_req_pack">True</field>
        </record>
        <record id="cat_vaccines" model="product.category">
            <field name="name">Vaccines</field>
