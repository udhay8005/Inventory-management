<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Apply FIFO removal strategy at the default warehouse stock location.
            wms_fifo registers a custom strategy id; falling back to Odoo's
            built-in fifo here gives a working default even if wms_fifo
            isn't installed yet.
        -->
        <function model="stock.location" name="write"
                  eval="[
                      [ref('stock.stock_location_stock')],
                      {'removal_strategy_id': ref('stock.removal_fifo')}
                  ]"/>

        <!--
            "Trust internal use" location — destination for Scan Issue.

            The trust never sells from the warehouse. It only buys (Scan
            Receipt) and uses (Scan Issue) inventory internally — feed
            to the cow shed, medicine to the vet, ghee to the pooja
            room, etc. The default Scan Issue destination of "Customers"
            is therefore misleading, and the Sales-side accounting it
            triggers (taxable delivery, invoicing) doesn't apply here.

            Seed a single internal-usage location that every Scan Issue
            defaults to. Admin can rename it or add sub-locations under
            it later (Cow Shed, Pooja Room, Field) without changing the
            wizard default.
        -->
        <!--
            Why no parent_id: this is a top-level location like
            ``stock.stock_location_customers`` (Customers). Keeping it
            sibling-of-warehouse means Scan Issue moves stock OUT of
            WH/Stock and into "Trust internal use" cleanly, mirroring
            how Customers works in upstream Odoo.
        -->
        <record id="stock_location_trust_use" model="stock.location">
            <field name="name">Trust internal use</field>
            <field name="usage">internal</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!--
            Internal system: NO public self-registration. UAT found the
            "Don't have an account?" link on the login page (auth_signup
            defaults to 'b2c' = anyone can sign up). Force invite-only
            ('b2b') so only an admin can create logins. We use set_param
            (idempotent upsert) rather than a <record>, because auth_signup
            already owns this ir.config_parameter row and a fresh record
            would collide on its unique key.
        -->
        <function model="ir.config_parameter" name="set_param"
                  eval="['auth_signup.invitation_scope', 'b2b']"/>
    </data>
</odoo>
