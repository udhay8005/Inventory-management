<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Seed one demo rack (R-01) by calling the wizard programmatically
            via a server action that fires on module install.
        -->
        <record id="demo_rack_setup" model="ir.actions.server">
            <field name="name">WMS demo: create R-01</field>
            <field name="model_id" ref="stock.model_stock_location"/>
            <field name="state">code</field>
            <field name="code">
gen = env['wms.rack.generator'].create({'rack_code': 'R-01', 'capacity_per_slot': 100})
gen.action_generate()
            </field>
        </record>

        <function model="ir.actions.server" name="run"
                  eval="[[ref('demo_rack_setup')]]"/>

    </data>
</odoo>
