<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Wave 2 #12 — Cold Chain Workflow: reading list / form / search + menu. -->
        <record id="view_wms_cold_chain_reading_list" model="ir.ui.view">
            <field name="name">wms.cold.chain.reading.list</field>
            <field name="model">wms.cold.chain.reading</field>
            <field name="arch" type="xml">
                <list string="Cold chain readings">
                    <field name="reading_datetime"/>
                    <field name="lot_id"/>
                    <field name="product_id"/>
                    <field name="temperature"/>
                    <field name="in_range"
                           decoration-danger="not in_range"
                           decoration-success="in_range"
                           widget="badge"/>
                    <field name="quarantine_id" optional="show"/>
                    <field name="recorded_by"/>
                </list>
            </field>
        </record>

        <record id="view_wms_cold_chain_reading_form" model="ir.ui.view">
            <field name="name">wms.cold.chain.reading.form</field>
            <field name="model">wms.cold.chain.reading</field>
            <field name="arch" type="xml">
                <form string="Cold chain reading">
                    <sheet>
                        <group>
                            <group>
                                <field name="lot_id"/>
                                <field name="product_id" readonly="1"/>
                                <field name="temperature"/>
                                <field name="reading_datetime"/>
                            </group>
                            <group>
                                <field name="in_range" readonly="1"/>
                                <field name="quarantine_id" readonly="1"/>
                                <field name="recorded_by" readonly="1"/>
                            </group>
                        </group>
                        <group string="Note">
                            <field name="note" nolabel="1" placeholder="Fridge id, excursion duration, corrective action..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_wms_cold_chain_reading_search" model="ir.ui.view">
            <field name="name">wms.cold.chain.reading.search</field>
            <field name="model">wms.cold.chain.reading</field>
            <field name="arch" type="xml">
                <search>
                    <field name="lot_id"/>
                    <field name="product_id"/>
                    <field name="recorded_by"/>
                    <filter name="out_of_range" string="Out of range"
                            domain="[('in_range','=',False)]"/>
                    <filter name="in_range" string="In range"
                            domain="[('in_range','=',True)]"/>
                    <separator/>
                    <filter name="quarantined" string="Raised a QC hold"
                            domain="[('quarantine_id','!=',False)]"/>
                    <separator/>
                    <filter name="group_product" string="Product"
                            context="{'group_by': 'product_id'}"/>
                    <filter name="group_recorded_by" string="Recorded by"
                            context="{'group_by': 'recorded_by'}"/>
                </search>
            </field>
        </record>

        <record id="action_wms_cold_chain_reading" model="ir.actions.act_window">
            <field name="name">Cold Chain Readings</field>
            <field name="res_model">wms.cold.chain.reading</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_wms_cold_chain_reading_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">No cold chain readings yet</p>
                <p>Log a temperature reading against a cold-chain lot. An out-of-range
                   reading automatically puts the lot on QC hold until it is reviewed.</p>
            </field>
        </record>

        <menuitem id="menu_wms_cold_chain_reading"
                  name="Cold Chain"
                  parent="menu_wms_analytics_root"
                  action="action_wms_cold_chain_reading"
                  sequence="120"/>
    </data>
</odoo>
