<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Wave 2 #7 — daily occupancy snapshot. Captures one row per storage
             location per day so occupancy can be charted over time. Idempotent
             per day (re-running refreshes that day's rows in place). -->
        <record id="cron_wms_occupancy_snapshot" model="ir.cron">
            <field name="name">WMS — Capture daily occupancy snapshot</field>
            <field name="model_id" ref="model_wms_occupancy_snapshot"/>
            <field name="state">code</field>
            <field name="code">model._cron_capture()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
