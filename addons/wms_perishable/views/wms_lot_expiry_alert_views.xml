<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_wms_lot_expiry_alert_list" model="ir.ui.view">
            <field name="name">wms.lot.expiry.alert.list</field>
            <field name="model">wms.lot.expiry.alert</field>
            <field name="arch" type="xml">
                <list string="Lot Expiry" create="false"
                      decoration-danger="status == 'expired'"
                      decoration-warning="status in ('d7', 'd15', 'd30')"
                      decoration-info="status in ('d60', 'd90')">
                    <field name="product_id"/>
                    <field name="lot_id"/>
                    <field name="expiry_date"/>
                    <field name="days_to_expiry"/>
                    <field name="on_hand"/>
                    <field name="unit_cost" optional="hide"/>
                    <field name="value_at_risk" sum="Value at risk"/>
                    <field name="lot_state"/>
                    <field name="supplier_id" optional="hide"/>
                    <field name="status"/>
                </list>
            </field>
        </record>

        <record id="view_wms_lot_expiry_alert_search" model="ir.ui.view">
            <field name="name">wms.lot.expiry.alert.search</field>
            <field name="model">wms.lot.expiry.alert</field>
            <field name="arch" type="xml">
                <search>
                    <field name="product_id"/>
                    <field name="lot_id"/>
                    <field name="supplier_id"/>
                    <filter name="expired" string="Expired" domain="[('status', '=', 'expired')]"/>
                    <filter name="near" string="Within 30 days"
                            domain="[('status', 'in', ('expired', 'd7', 'd15', 'd30'))]"/>
                    <separator/>
                    <filter name="g_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="g_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="g_supplier" string="Supplier" context="{'group_by': 'supplier_id'}"/>
                </search>
            </field>
        </record>

        <record id="action_wms_lot_expiry_alert" model="ir.actions.act_window">
            <field name="name">Lot Expiry</field>
            <field name="res_model">wms.lot.expiry.alert</field>
            <field name="view_mode">list</field>
            <field name="context">{'search_default_near': 1}</field>
        </record>

        <menuitem id="menu_wms_lot_expiry_alert"
                  name="Lot Expiry (per batch)"
                  parent="wms_reports.menu_wms_reports_root"
                  action="action_wms_lot_expiry_alert"
                  sequence="25"/>
    </data>
</odoo>
