<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
          V20-022 — per-product shelf-life overrides on the product form. Added
          to the existing "WMS Classification" page (wms_location), shown only
          for products that track an expiry date (perishables). 0 = use the kind
          policy, then the global fallback.
        -->
        <record id="view_product_template_form_perishable_shelf_life" model="ir.ui.view">
            <field name="name">product.template.form.perishable.shelf.life</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='wms_classification']" position="inside">
                    <group string="Perishable shelf life (override)" name="wms_shelf_life_override">
                        <field name="use_expiration_date" invisible="1"/>
                        <field name="wms_shelf_life_days"
                               invisible="not use_expiration_date"/>
                        <field name="wms_min_receive_life_days"
                               invisible="not use_expiration_date"/>
                        <field name="wms_min_issue_life_days"
                               invisible="not use_expiration_date"/>
                        <label for="id" string="Non-perishable product — shelf-life overrides do not apply."
                               invisible="use_expiration_date"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
