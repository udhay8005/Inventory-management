<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Weekly Monday 09:00 reminder for slots not counted in > 30 days.
            Posts a Discuss notification to every WMS Manager.
        -->
        <record id="cron_wms_cycle_count_reminder" model="ir.cron">
            <field name="name">WMS — Weekly cycle-count reminder</field>
            <field name="model_id" ref="model_wms_cycle_count_cron"/>
            <field name="state">code</field>
            <field name="code">model.run_weekly_reminder()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">7</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="nextcall"
                   eval="(DateTime.now() + timedelta(days=(7 - DateTime.now().weekday()) % 7)).replace(hour=9, minute=0, second=0)"/>
        </record>

        <!--
            Weekly Monday 09:00 digest of perishable products that
            are already expired or about to expire within 30 days.
            Quiet when nothing matches (the model bails on empty set).
        -->
        <record id="cron_wms_expiry_digest" model="ir.cron">
            <field name="name">WMS — Weekly expiry alert digest</field>
            <field name="model_id" ref="model_wms_expiry_alert"/>
            <field name="state">code</field>
            <field name="code">model._cron_post_expiry_digest()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">7</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="nextcall"
                   eval="(DateTime.now() + timedelta(days=(7 - DateTime.now().weekday()) % 7)).replace(hour=9, minute=5, second=0)"/>
        </record>

        <!--
            Daily 08:00 backup-freshness check. Escalates a stale backup
            (> 24h) or stale restore drill (> 7d) into an append-only
            staleness_warning row + a Discuss notice to WMS Managers.
            Quiet when healthy; at most one warning row per ~day.
        -->
        <!--
            Daily 08:10 low-stock alert. Notifies every WMS Manager (Discuss
            inbox; email too when wms_reports.alert_email = 1) of products at
            or below their reorder level. Silent when nothing needs ordering.
        -->
        <record id="cron_wms_low_stock_alert" model="ir.cron">
            <field name="name">WMS — Daily low-stock alert</field>
            <field name="model_id" ref="model_wms_stock_alert"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_low_stock()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="nextcall"
                   eval="(DateTime.now() + timedelta(days=1)).replace(hour=8, minute=10, second=0)"/>
        </record>

        <record id="cron_wms_backup_freshness" model="ir.cron">
            <field name="name">WMS — Daily backup freshness check</field>
            <field name="model_id" ref="model_wms_backup_audit"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_backup_freshness()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="nextcall"
                   eval="(DateTime.now() + timedelta(days=1)).replace(hour=8, minute=0, second=0)"/>
        </record>

        <!--
            Hourly restore-drill failure detector (maturity C). The drill
            script writes success=False rows directly; this cron pings WMS
            managers (in-app + optional email) so a failure can no longer
            sit silently in the audit table until someone opens the report.
        -->
        <record id="cron_wms_restore_drill_check" model="ir.cron">
            <field name="name">WMS — Restore-drill failure alert</field>
            <field name="model_id" ref="model_wms_backup_audit"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_restore_drill()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
            <field name="nextcall"
                   eval="(DateTime.now() + timedelta(hours=1)).replace(minute=15, second=0)"/>
        </record>

        <!--
            Every 4h health-CRITICAL escalation (maturity C). The daily
            freshness check fires at 08:00 only; CRITICAL is too important
            to wait that long. Idempotent (one alert per ~20h).
        -->
        <record id="cron_wms_health_critical_escalate" model="ir.cron">
            <field name="name">WMS — Health CRITICAL escalation</field>
            <field name="model_id" ref="model_wms_backup_audit"/>
            <field name="state">code</field>
            <field name="code">model._cron_escalate_health_critical()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">4</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
            <field name="nextcall"
                   eval="(DateTime.now() + timedelta(hours=4)).replace(minute=20, second=0)"/>
        </record>
    </data>
</odoo>
