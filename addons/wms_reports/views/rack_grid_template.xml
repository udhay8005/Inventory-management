<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
            Full-page QWeb template for /wms/rack/<id>/grid.

            Uses CSS Grid with `grid-row: start / end` so compartments
            spanning multiple shelves (e.g. a tall column for bottles
            covering shelves 1-3) render as a single tall cell at the
            correct height. Shelf 1 sits at the top of the grid to
            match the physical view of the rack.
        -->
        <template id="rack_grid_page" name="WMS Rack Visual Grid">
            <t t-call="web.html_container">
                <head>
                    <title t-esc="'Rack %s — WMS' % rack.wms_rack_code"/>
                    <meta charset="utf-8"/>
                    <meta name="viewport" content="width=device-width, initial-scale=1"/>
                    <t t-call-assets="web.assets_frontend_minimal"
                       t-css="true" t-js="false"/>
                    <style>
                        .wms-rack-grid {
                            display: grid;
                            gap: 4px;
                            background: #1f2933;
                            padding: 6px;
                            border-radius: 4px;
                        }
                        .wms-rack-grid__cell {
                            padding: 6px;
                            border-radius: 3px;
                            font-size: 11px;
                            line-height: 1.2;
                            display: flex;
                            flex-direction: column;
                            justify-content: flex-start;
                        }
                        .wms-rack-grid__cell-head {
                            display: flex;
                            justify-content: space-between;
                            font-weight: 600;
                        }
                        .wms-rack-grid__cell-products {
                            margin-top: 4px;
                            font-size: 10px;
                            opacity: 0.85;
                            overflow: hidden;
                            text-overflow: ellipsis;
                        }
                    </style>
                </head>
                <body>
                <div class="container-fluid my-3">

                    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                        <div>
                            <h2 class="mb-0">
                                Rack <span t-esc="rack.wms_rack_code"/>
                                <small class="text-muted ms-2" t-esc="rack.complete_name"/>
                            </h2>
                            <small>
                                <span t-esc="shelves"/> shelves ×
                                <span t-esc="columns"/> columns ·
                                <span t-esc="total_slots"/> slots ·
                                <strong t-esc="rack_on_hand_label"/> units on hand
                            </small>
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            <span class="badge bg-light text-muted px-2 py-1">Empty</span>
                            <span class="badge bg-info text-white px-2 py-1">Stocked (no capacity set)</span>
                            <span class="badge bg-success text-white px-2 py-1">≤ 75%</span>
                            <span class="badge bg-warning text-dark px-2 py-1">76 – 99%</span>
                            <span class="badge bg-danger text-white px-2 py-1">Full / Over</span>
                            <a t-att-href="'/odoo/action-base.action_open_window?type=ir.actions.act_window&amp;res_model=stock.location&amp;res_id=' + str(rack.id)"
                               class="btn btn-sm btn-outline-secondary">
                                Open in Odoo
                            </a>
                        </div>
                    </div>

                    <div t-if="not cells" class="alert alert-warning">
                        This rack has no compartments yet. Use
                        <em>WMS → Configuration → Create Rack</em> to set it up.
                    </div>

                    <div t-if="cells"
                         class="wms-rack-grid"
                         t-att-style="'grid-template-rows: repeat(%d, minmax(70px, auto)); grid-template-columns: repeat(%d, minmax(120px, 1fr));' % (shelves, columns)">
                        <t t-foreach="cells" t-as="cell">
                            <div t-att-class="'wms-rack-grid__cell ' + cell['color']"
                                 t-att-style="'grid-row: %d / %d; grid-column: %d / %d;' % (cell['row_start'], cell['row_end'], cell['col_start'], cell['col_end'])"
                                 t-att-title="cell['compartment'].complete_name + ' — ' + cell['on_hand_label'] + ' units'">
                                <div class="wms-rack-grid__cell-head">
                                    <span t-esc="cell['compartment'].name"/>
                                    <span t-esc="cell['on_hand_label']"/>
                                </div>
                                <div t-if="cell['products']" class="wms-rack-grid__cell-products">
                                    <t t-foreach="cell['products']" t-as="p">
                                        <span t-esc="p.default_code or p.name"/><t t-if="not p_last">, </t>
                                    </t>
                                </div>
                                <div t-elif="cell['on_hand'] > 0">
                                    <small t-esc="cell['pct_label']"/>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
                </body>
            </t>
        </template>

        <!--
            Server action that, given a rack record, opens its visual grid.
            Plugged into the rack form via a button.
        -->
        <record id="action_open_rack_grid" model="ir.actions.server">
            <field name="name">Open visual grid</field>
            <field name="model_id" ref="stock.model_stock_location"/>
            <field name="binding_model_id" ref="stock.model_stock_location"/>
            <field name="binding_view_types">form,list</field>
            <field name="state">code</field>
            <field name="code">
if record and record.wms_location_type == 'rack':
    action = {
        'type': 'ir.actions.act_url',
        'url': '/wms/rack/%d/grid' % record.id,
        'target': 'new',
    }
            </field>
        </record>
    </data>
</odoo>
