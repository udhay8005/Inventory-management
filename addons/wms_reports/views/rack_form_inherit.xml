<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
            Adds a "Visual grid" smart button to the stock.location form
            when the location is a Rack. Server action returns an act_url
            that opens /wms/rack/<id>/grid in a new tab.
        -->
        <record id="view_stock_location_form_wms_grid_button" model="ir.ui.view">
            <field name="name">stock.location.form.wms.grid_button</field>
            <field name="model">stock.location</field>
            <field name="inherit_id" ref="stock.view_location_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="before">
                    <header invisible="wms_location_type != 'rack'">
                        <button name="%(wms_reports.action_open_rack_grid)d"
                                type="action"
                                string="Open visual grid"
                                class="btn-primary"
                                icon="fa-th"/>
                    </header>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
