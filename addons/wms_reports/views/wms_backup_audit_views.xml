<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Append-only operational audit. create/edit/delete all disabled in
         the UI: rows are written by the backup + restore-drill scripts. -->
    <record id="view_wms_backup_audit_list" model="ir.ui.view">
        <field name="name">wms.backup.audit.list</field>
        <field name="model">wms.backup.audit</field>
        <field name="arch" type="xml">
            <list string="Backup &amp; DR Audit"
                  create="0" edit="0" delete="0"
                  decoration-danger="success == False"
                  decoration-success="success == True">
                <field name="event_time"/>
                <field name="audit_type"/>
                <field name="name"/>
                <field name="success" widget="boolean_toggle"/>
                <field name="verified" optional="show"/>
                <field name="size_mb" optional="show" sum="Total MB"/>
                <field name="toc_entries" optional="hide"/>
                <field name="duration_seconds" optional="hide"/>
                <field name="host" optional="hide"/>
                <field name="message" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_wms_backup_audit_form" model="ir.ui.view">
        <field name="name">wms.backup.audit.form</field>
        <field name="model">wms.backup.audit</field>
        <field name="arch" type="xml">
            <form string="Backup / DR Event" create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="event_time"/>
                            <field name="audit_type"/>
                            <field name="name"/>
                            <field name="success"/>
                            <field name="verified"/>
                        </group>
                        <group>
                            <field name="size_mb"/>
                            <field name="toc_entries"/>
                            <field name="duration_seconds"/>
                            <field name="checksum"/>
                            <field name="host"/>
                        </group>
                    </group>
                    <group string="Message / errors">
                        <field name="message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_wms_backup_audit_search" model="ir.ui.view">
        <field name="name">wms.backup.audit.search</field>
        <field name="model">wms.backup.audit</field>
        <field name="arch" type="xml">
            <search string="Backup &amp; DR Audit">
                <field name="name"/>
                <field name="host"/>
                <filter name="failures" string="Failures only"
                        domain="[('success', '=', False)]"/>
                <filter name="backups" string="Backups"
                        domain="[('audit_type', 'in', ['backup_db', 'backup_filestore'])]"/>
                <filter name="drills" string="Restore drills"
                        domain="[('audit_type', '=', 'restore_drill')]"/>
                <filter name="warnings" string="Staleness warnings"
                        domain="[('audit_type', '=', 'staleness_warning')]"/>
                <separator/>
                <filter name="group_type" string="Type"
                        context="{'group_by': 'audit_type'}"/>
                <filter name="group_success" string="Outcome"
                        context="{'group_by': 'success'}"/>
            </search>
        </field>
    </record>

    <record id="action_wms_backup_audit" model="ir.actions.act_window">
        <field name="name">Backup &amp; DR Audit</field>
        <field name="res_model">wms.backup.audit</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wms_backup_audit_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No backup events recorded yet.</p>
            <p>Rows here are written automatically by
               <code>scripts/backup-native.ps1</code> and
               <code>scripts/restore-drill.ps1</code> after each run.</p>
        </field>
    </record>

    <menuitem id="menu_wms_backup_audit"
              name="Backup &amp; DR Audit"
              parent="menu_wms_reports_root"
              action="action_wms_backup_audit"
              sequence="95"
              groups="wms_location.group_wms_manager"/>
</odoo>
