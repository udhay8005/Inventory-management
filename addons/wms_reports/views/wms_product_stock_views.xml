<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_wms_product_stock_list" model="ir.ui.view">
            <field name="name">wms.product.stock.list</field>
            <field name="model">wms.product.stock.report</field>
            <field name="arch" type="xml">
                <list decoration-bf="is_oldest" decoration-success="is_oldest">
                    <field name="product_id"/>
                    <field name="product_barcode"/>
                    <field name="quantity"/>
                    <field name="available_quantity"/>
                    <field name="reserved_quantity" optional="hide"/>
                    <field name="location_id"/>
                    <field name="divider_id" optional="show"/>
                    <field name="level_id" optional="show"/>
                    <field name="rack_id" optional="show"/>
                    <field name="in_date"/>
                    <field name="age_days"/>
                    <field name="is_oldest" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="view_wms_product_stock_search" model="ir.ui.view">
            <field name="name">wms.product.stock.search</field>
            <field name="model">wms.product.stock.report</field>
            <field name="arch" type="xml">
                <search>
                    <field name="product_id"/>
                    <field name="product_barcode"/>
                    <field name="location_id"/>
                    <field name="rack_id"/>
                    <filter name="oldest_first" string="Next to pick (FIFO)"
                            domain="[('is_oldest', '=', True)]"/>
                    <filter name="group_product" string="Group by Product"
                            context="{'group_by': 'product_id'}"/>
                    <filter name="group_rack" string="Group by Rack"
                            context="{'group_by': 'rack_id'}"/>
                </search>
            </field>
        </record>

        <record id="view_wms_product_stock_pivot" model="ir.ui.view">
            <field name="name">wms.product.stock.pivot</field>
            <field name="model">wms.product.stock.report</field>
            <field name="arch" type="xml">
                <pivot>
                    <field name="product_id" type="row"/>
                    <field name="rack_id" type="col"/>
                    <field name="quantity" type="measure"/>
                </pivot>
            </field>
        </record>

        <record id="action_wms_product_stock" model="ir.actions.act_window">
            <field name="name">Where is product X?</field>
            <field name="res_model">wms.product.stock.report</field>
            <field name="view_mode">list,pivot</field>
            <field name="search_view_id" ref="view_wms_product_stock_search"/>
            <field name="context">{'search_default_group_product': 1}</field>
        </record>
    </data>
</odoo>
