<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <menuitem id="menu_wms_reports_root"
                  name="Reports"
                  parent="wms_location.menu_wms_root"
                  sequence="70"/>

        <menuitem id="menu_wms_warehouse_map"
                  name="Warehouse Map"
                  parent="menu_wms_reports_root"
                  action="action_warehouse_map"
                  sequence="1"/>

        <menuitem id="menu_wms_product_stock"
                  name="Where is product X?"
                  parent="menu_wms_reports_root"
