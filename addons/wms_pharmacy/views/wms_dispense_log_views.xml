<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================
             wms.dispense.log — list view
             ============================================================ -->
        <record id="view_wms_dispense_log_list" model="ir.ui.view">
            <field name="name">wms.dispense.log.list</field>
            <field name="model">wms.dispense.log</field>
            <field name="arch" type="xml">
                <list string="Dispense log" create="false" edit="false">
                    <field name="dispense_date"/>
                    <field name="product_id"/>
                    <field name="lot_id"/>
                    <field name="animal_id"/>
                    <field name="quantity"/>
                    <field name="strips_opened"/>
                    <field name="tablets_per_strip"/>
                    <field name="tablets_per_box"/>
                    <field name="dispensed_by"/>
                </list>
            </field>
        </record>

        <!-- ============================================================
             wms.dispense.log — form view (read-only audit trail)
             ============================================================ -->
        <record id="view_wms_dispense_log_form" model="ir.ui.view">
            <field name="name">wms.dispense.log.form</field>
            <field name="model">wms.dispense.log</field>
            <field name="arch" type="xml">
                <form string="Dispense genealogy log" create="false">
                    <sheet>
                        <group string="Dispense event">
                            <group>
                                <field name="dispense_date"/>
                                <field name="product_id"/>
                                <field name="lot_id"/>
                                <field name="animal_id"/>
                            </group>
                            <group>
                                <field name="quantity"/>
                                <field name="dispensed_by"/>
                                <field name="picking_id"/>
                            </group>
                        </group>
                        <group string="Packaging genealogy (snapshot)">
                            <field name="strips_opened"/>
                            <field name="tablets_per_strip"/>
                            <field name="tablets_per_box"/>
                        </group>
                        <group string="Note">
                            <field name="note" nolabel="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ============================================================
             wms.dispense.log — search + group-by view
             ============================================================ -->
        <record id="view_wms_dispense_log_search" model="ir.ui.view">
            <field name="name">wms.dispense.log.search</field>
            <field name="model">wms.dispense.log</field>
            <field name="arch" type="xml">
                <search string="Search medication / genealogy log">
                    <field name="product_id"/>
                    <field name="lot_id"/>
                    <field name="animal_id"/>
                    <field name="dispensed_by"/>
                    <separator/>
                    <filter string="This month" name="this_month"
                            domain="[('dispense_date','&gt;=', (context_today()).strftime('%Y-%m-01'))]"/>
                    <separator/>
                    <filter string="By animal" name="group_animal"
                            context="{'group_by': 'animal_id'}"/>
                    <filter string="By product" name="group_product"
                            context="{'group_by': 'product_id'}"/>
                    <filter string="By month" name="group_month"
                            context="{'group_by': 'dispense_date:month'}"/>
                </search>
            </field>
        </record>

        <!-- ============================================================
             Actions
             ============================================================ -->
        <record id="action_wms_dispense_log" model="ir.actions.act_window">
            <field name="name">Medication History / Genealogy Log</field>
            <field name="res_model">wms.dispense.log</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_wms_dispense_log_search"/>
            <field name="context">{'search_default_group_animal': 1}</field>
        </record>

        <!-- Genealogy-focused action (group by product/lot) -->
        <record id="action_wms_dispense_genealogy" model="ir.actions.act_window">
            <field name="name">Packaging Genealogy</field>
            <field name="res_model">wms.dispense.log</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_wms_dispense_log_search"/>
            <field name="context">{'search_default_group_product': 1}</field>
        </record>

    </data>
</odoo>
