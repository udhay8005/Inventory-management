<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--
            Product label batch — appears in the Print menu of product.product.
            Multi-record aware: select N products, click Print > WMS Product
            Labels, get a single PDF with 24 labels per A4 sheet.
        -->
        <record id="action_report_wms_product_label" model="ir.actions.report">
            <field name="name">WMS Product Labels</field>
            <field name="model">product.product</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">wms_barcode.report_product_label</field>
            <field name="report_file">wms_barcode.report_product_label</field>
            <field name="print_report_name">'Product-labels-%d' % len(docs)</field>
            <field name="binding_model_id" ref="product.model_product_product"/>
            <field name="binding_type">report</field>
        </record>

        <!--
            Location (slot / rack / divider) label batch.
            Recommended use: WMS → Operations → Slots → multi-select
            (the list view supports filtering by Rack) → Print > WMS
            Location Labels. 2,304 slots = 96 A4 sheets (3×8 per sheet).
        -->
        <record id="action_report_wms_location_label" model="ir.actions.report">
            <field name="name">WMS Location Labels</field>
            <field name="model">stock.location</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">wms_barcode.report_location_label</field>
            <field name="report_file">wms_barcode.report_location_label</field>
            <field name="print_report_name">'Location-labels-%d' % len(docs)</field>
            <field name="binding_model_id" ref="stock.model_stock_location"/>
            <field name="binding_type">report</field>
        </record>

    </data>
</odoo>
