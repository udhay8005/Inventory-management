<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--
            4 inch × 1 inch (102 × 25 mm) paper format.
            203 DPI matches the trust's thermal printer head.
            Zero margins: the printer's hardware has its own border;
            we want the entire 102×25 mm available to position
            the barcode / logo / text wherever the Admin chooses.
        -->
        <!--
            Set orientation=Portrait + width 102 / height 25.
            wkhtmltopdf otherwise swaps width and height when
            orientation=Landscape, ending up with a 25×102 mm portrait
            page and a label squashed at the top.
        -->
        <record id="paperformat_wms_thermal_4x1" model="report.paperformat">
            <field name="name">WMS Thermal Label 4×1 in</field>
            <field name="format">custom</field>
            <field name="page_width">102</field>
            <field name="page_height">25</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">0</field>
            <field name="margin_bottom">0</field>
            <field name="margin_left">0</field>
            <field name="margin_right">0</field>
            <field name="header_line">False</field>
            <field name="header_spacing">0</field>
            <field name="dpi">203</field>
        </record>

        <!--
            Thermal product label — one sticker per product, suitable
            for printing on a 4×1 inch roll printer. Layout is driven
            by the Admin's wms.label.config (Configuration → Label
            Settings) so the barcode / logo / text can be placed
            anywhere on the sticker.
        -->
        <record id="action_report_wms_product_label_thermal" model="ir.actions.report">
            <field name="name">WMS Product Label (Thermal 4×1)</field>
            <field name="model">product.product</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">wms_barcode.report_product_label_thermal</field>
            <field name="report_file">wms_barcode.report_product_label_thermal</field>
            <field name="print_report_name">'Thermal-product-labels-%d' % len(docs)</field>
            <field name="paperformat_id" ref="paperformat_wms_thermal_4x1"/>
            <field name="binding_model_id" ref="product.model_product_product"/>
            <field name="binding_type">report</field>
        </record>

        <record id="action_report_wms_location_label_thermal" model="ir.actions.report">
            <field name="name">WMS Location Label (Thermal 4×1)</field>
            <field name="model">stock.location</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">wms_barcode.report_location_label_thermal</field>
            <field name="report_file">wms_barcode.report_location_label_thermal</field>
            <field name="print_report_name">'Thermal-location-labels-%d' % len(docs)</field>
            <field name="paperformat_id" ref="paperformat_wms_thermal_4x1"/>
            <field name="binding_model_id" ref="stock.model_stock_location"/>
            <field name="binding_type">report</field>
        </record>

    </data>
</odoo>
