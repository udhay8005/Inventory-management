<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_wms_scan_issue_form" model="ir.ui.view">
            <field name="name">wms.scan.issue.form</field>
            <field name="model">wms.scan.issue</field>
            <field name="arch" type="xml">
                <form string="Scan Issue">
                    <sheet>
                        <div class="alert alert-info">
                            <strong>Set the quantity, then scan the product.</strong>
                            The system automatically picks the oldest stock first,
                            across all slots &#8212; you don't choose the batch.
                            Scan a carton barcode to use its preset count.
                            Stuck? See <b>Help &amp; Training &#8594; Getting Started</b>.
                        </div>
                        <div class="row">
                            <div class="col-12 col-md-6">
                                <field name="warehouse_id"/>
                            </div>
                            <div class="col-12 col-md-6">
                                <field name="destination_id"/>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-12 col-md-4">
                                <label for="requested_qty" class="fw-bold"/>
                                <field name="requested_qty" nolabel="1"/>
                            </div>
                            <div class="col-12 col-md-8">
                                <label for="last_scan" class="fw-bold"/>
                                <field name="last_scan"
                                       placeholder="Scan product / carton..."
                                       default_focus="1" nolabel="1"/>
                            </div>
                            <div class="col-12">
                                <field name="feedback" readonly="1" nolabel="1"/>
                            </div>
                        </div>
                        <field name="plan_line_ids" class="mt-3">
                            <list>
                                <field name="product_id"/>
                                <field name="location_id" string="Slot"/>
                                <field name="in_date" string="Arrived"/>
                                <field name="expiry_date" string="Expires" optional="show"
                                       decoration-danger="expiry_date and expiry_date &lt;= (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d')"
                                       decoration-warning="expiry_date and expiry_date &lt;= (context_today() + relativedelta(days=90)).strftime('%Y-%m-%d')"/>
                                <field name="available" string="On shelf"/>
                                <field name="take" string="Will take"/>
                            </list>
                        </field>
                        <div class="alert alert-warning mt-2" role="alert"
                             invisible="not short_qty">
                            <strong>Not enough stock for the full quantity.</strong>
                            Lower the quantity and tap <b>Check stock</b> again to
                            take what's available, or <b>Cancel</b>.
                        </div>
                        <div class="row mt-2">
                            <div class="col-12 col-md-4">
                                <field name="short_qty" string="Short by"
                                       readonly="1" invisible="not short_qty"/>
                            </div>
                            <div class="col-12 col-md-8">
                                <field name="photo_required" invisible="1"/>
                                <label for="photo">
                                    Item photo
                                    <span class="text-danger ms-1"
                                          invisible="not photo_required">
                                        * required
                                    </span>
                                </label>
                                <!--
                                    widget="image" renders an <input type="file"
                                    accept="image/*"> which on mobile browsers
                                    triggers the OS camera picker. The picker
                                    closes automatically after capture.
                                -->
                                <field name="photo" widget="image"
                                       nolabel="1"
                                       options="{'size': [400, 300]}"/>
                            </div>
                        </div>

                        <div class="row mt-3 border-top pt-3">
                            <div class="col-12">
                                <h6 class="text-uppercase text-muted"
                                    style="font-size:11px;">
                                    Audit trail
                                </h6>
                            </div>
                            <div class="col-12 col-md-4">
                                <label for="taken_by"/>
                                <field name="taken_by"
                                       placeholder="Name of the person taking these items"/>
                            </div>
                            <div class="col-12 col-md-4">
                                <label for="ordered_by"/>
                                <field name="ordered_by"
                                       placeholder="Name of the person who authorised this"/>
                            </div>
                            <div class="col-12 col-md-4">
                                <label for="storekeeper_id"/>
                                <field name="storekeeper_id"
                                       options="{'no_create': True, 'no_open': True}"
                                       placeholder="Select on-duty Store Keeper"/>
                            </div>
                            <!--
                                Mandatory usage note — what is the stock
                                going to be used for? Validates accountability
                                + helps reconcile against monthly cow-care
                                plans. Required at the model layer so
                                clicking Validate without a note throws
                                a UserError.
                            -->
                            <!--
                                Issue dimensions (F1). Department is required
                                (defaults to 'Other'); Purpose and Animal are
                                optional. issued_for is now derived from the
                                department on validate, so it's hidden here
                                but kept in the form so the field still posts.
                            -->
                            <div class="col-12 col-md-4 mt-2">
                                <label for="department_id" class="fw-bold"/>
                                <span class="text-danger ms-1">* required</span>
                                <field name="department_id" nolabel="1"
                                       options="{'no_create': True, 'no_open': True}"/>
                            </div>
                            <div class="col-12 col-md-4 mt-2">
                                <label for="purpose_id" class="fw-bold"/>
                                <span class="text-muted ms-1">(optional)</span>
                                <field name="purpose_id" nolabel="1"
                                       options="{'no_create': True, 'no_open': True}"/>
                            </div>
                            <div class="col-12 col-md-4 mt-2">
                                <label for="animal_id" class="fw-bold"/>
                                <span class="text-muted ms-1">(optional)</span>
                                <field name="animal_id" nolabel="1"
                                       options="{'no_create': True, 'no_open': True}"/>
                            </div>
                            <field name="issued_for" invisible="1"/>
                            <div class="col-12 mt-2">
                                <label for="usage_note" class="fw-bold"/>
                                <span class="text-danger ms-1">* required</span>
                                <field name="usage_note"
                                       nolabel="1"
                                       placeholder="Why is this stock being taken? (e.g. 'morning feed for shed B', 'replacing broken pump', 'monthly vaccination round')"/>
                            </div>
                            <!--
                                Manager-approval reason (F4 + F5). Hidden until
                                needs_approval is True — a lightweight pre-check
                                run when the plan is built — so the box appears
                                only when the issue is high-value or was
                                requested too soon. The HARD gate re-checks in
                                action_validate inside the per-product lock.
                            -->
                            <field name="needs_approval" invisible="1"/>
                            <div class="col-12 mt-2" invisible="not needs_approval">
                                <div class="alert alert-warning" role="alert">
                                    <strong>This issue needs a Manager's approval.</strong>
                                    It is high value or your department requested
                                    this item recently. Type a reason and submit —
                                    it will be sent to a Manager. No stock moves
                                    until the Manager approves.
                                </div>
                                <label for="keeper_reason" class="fw-bold"/>
                                <field name="keeper_reason"
                                       nolabel="1"
                                       required="needs_approval"
                                       placeholder="Why should this issue still go through? (e.g. 'emergency treatment, vet authorised', 'bulk order pre-approved by Manager')"/>
                            </div>
                        </div>
                    </sheet>
                    <footer>
                        <button name="action_plan" type="object"
                                string="Check stock"/>
                        <button name="action_validate" type="object"
                                string="Validate" class="btn-primary"
                                invisible="short_qty &gt; 0"/>
                        <button special="cancel" string="Cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_wms_scan_issue" model="ir.actions.act_window">
            <field name="name">Scan Issue</field>
            <field name="res_model">wms.scan.issue</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
