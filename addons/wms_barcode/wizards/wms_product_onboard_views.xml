<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--
            Bulk onboard wizard. One editable table; same screen
            handles a single tap-in (one row) and a 200-row import
            (paste from Excel into the editable list).
        -->
        <record id="view_wms_product_onboard_form" model="ir.ui.view">
            <field name="name">wms.product.onboard.form</field>
            <field name="model">wms.product.onboard</field>
            <field name="arch" type="xml">
                <form string="Onboard new products">
                    <sheet>
                        <div class="alert alert-info">
                            <strong>Tip:</strong> paste a column of names from
                            Excel/Google Sheets directly into the table to
                            add many rows at once. Each row gets an
                            auto-SKU (e.g. TOOL-00001), an auto Code128
                            barcode, and an EAN-13 alias. If you set the
                            quantity and slot, the initial stock is placed
                            on submit.
                        </div>

                        <field name="line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="name"/>
                                <field name="wms_product_kind"/>
                                <field name="initial_qty"/>
                                <field name="location_id"/>
                                <field name="location_scan" string="Scan slot"
                                       placeholder="or scan barcode"/>
                                <!--
                                    Conditional columns. Hidden by default
                                    (optional="hide") so the table stays
                                    narrow for the common case; the Admin
                                    ticks them in the column picker - or
                                    Odoo shows them automatically when a
                                    row needs them via the
                                    column_invisible attribute.
                                -->
                                <field name="expiry_date"
                                       string="Expiry"
                                       optional="show"
                                       column_invisible="False"
                                       required="wms_product_kind in ['medicine', 'feed']"/>
                                <field name="batch_number"
                                       string="Batch"
                                       optional="hide"/>
                                <field name="volume_litres"
                                       string="Litres"
                                       optional="hide"/>
                                <field name="supplier_id" optional="hide"/>
                                <field name="list_price" optional="hide"/>
                            </list>
                        </field>

                        <group>
                            <field name="summary" readonly="1" nolabel="1"
                                   invisible="not summary"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_onboard" type="object"
                                class="btn-primary"
                                string="Onboard + Print labels"/>
                        <button name="action_onboard_no_print" type="object"
                                class="btn-secondary"
                                string="Onboard only"/>
                        <button special="cancel" string="Cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_wms_product_onboard" model="ir.actions.act_window">
            <field name="name">Onboard products</field>
            <field name="res_model">wms.product.onboard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>
