<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_wms_scan_receipt_form" model="ir.ui.view">
            <field name="name">wms.scan.receipt.form</field>
            <field name="model">wms.scan.receipt</field>
            <field name="arch" type="xml">
                <form string="Scan Receipt">
                    <sheet>
                        <div class="alert alert-info" role="alert" invisible="is_return">
                            <strong>Scanner ready.</strong>
                            Cursor stays in the scan field — each barcode is
                            processed automatically. Carton barcodes auto-fill
                            their unit count.
                        </div>
                        <div class="alert alert-warning" role="alert" invisible="not is_return">
                            <strong>Return entry mode.</strong>
                            Stock is being received back from production / a customer /
                            an internal location. Only products flagged as
                            <b>Returnable</b> can be received this way; fluids and
                            consumables will be refused at Validate.
                        </div>
                        <div class="row">
                            <div class="col-12 col-md-4">
                                <field name="warehouse_id"/>
                            </div>
                            <div class="col-12 col-md-4">
                                <field name="is_return" widget="boolean_toggle"/>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-12">
                                <label for="last_scan" class="fw-bold"/>
                                <field name="last_scan"
                                       placeholder="Scan product, carton, or slot..."
                                       default_focus="1" nolabel="1"/>
                            </div>
                            <div class="col-12">
                                <field name="feedback" readonly="1" nolabel="1"/>
                            </div>
                        </div>
                        <field name="line_ids" class="mt-3">
                            <list editable="bottom">
                                <field name="product_id"/>
                                <field name="quantity"/>
                                <field name="lot_id" optional="hide"/>
                                <field name="location_dest_id"/>
                            </list>
                        </field>

                        <!-- Hidden helpers used by visibility expressions -->
                        <field name="is_manager" invisible="1"/>
                        <field name="approval_required" invisible="1"/>
                        <field name="currency_id" invisible="1"/>

                        <div class="row mt-3 border-top pt-3">
                            <div class="col-12 col-md-6">
                                <h6 class="text-uppercase text-muted" style="font-size:11px;">
                                    Quality check
                                </h6>
                                <field name="qc_passed"/>
                                <field name="qc_notes" placeholder="Anything unusual? (optional)"/>
                            </div>
                            <div class="col-12 col-md-6">
                                <h6 class="text-uppercase text-muted" style="font-size:11px;">
                                    Approval
                                </h6>
                                <group>
                                    <field name="total_value" widget="monetary"/>
                                    <field name="approval_threshold" widget="monetary"/>
                                    <field name="approved_by_id" readonly="1"
                                           invisible="not approval_required"/>
                                </group>
                                <div class="alert alert-warning"
                                     invisible="not approval_required or approved_by_id"
                                     role="alert">
                                    Total exceeds approval threshold — a WMS
                                    Manager must approve before Validate.
                                </div>
                                <button name="action_approve" type="object"
                                        string="Approve receipt" class="btn-warning"
                                        invisible="not approval_required or approved_by_id or not is_manager"/>
                            </div>
                        </div>
                    </sheet>
                    <footer>
                        <button name="action_process_scan" type="object"
                                string="Process scan"/>
                        <button name="action_validate" type="object"
                                string="Validate &amp; Print" class="btn-primary"/>
                        <button special="cancel" string="Cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_wms_scan_receipt" model="ir.actions.act_window">
            <field name="name">Scan Receipt</field>
            <field name="res_model">wms.scan.receipt</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!--
            Scan Return = same wizard, with the is_return toggle pre-set
            via context. The Store Keeper opens this menu when receiving
            a tool / spare coming back from production. Non-returnable
            products (fluids, consumables) are rejected at Validate.
        -->
        <record id="action_wms_scan_return" model="ir.actions.act_window">
            <field name="name">Scan Return</field>
            <field name="res_model">wms.scan.receipt</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{'default_is_return': True}</field>
        </record>
    </data>
</odoo>
