<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_wms_scan_receipt_form" model="ir.ui.view">
            <field name="name">wms.scan.receipt.form</field>
            <field name="model">wms.scan.receipt</field>
            <field name="arch" type="xml">
                <form string="Scan Receipt">
                    <group>
                        <field name="warehouse_id"/>
                    </group>
                    <group>
                        <field name="last_scan" widget="char" placeholder="scan here..."/>
                        <button name="action_process_scan" type="object"
                                string="Process scan" class="btn-primary"/>
                    </group>
                    <field name="feedback" readonly="1"/>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="lot_id"/>
                            <field name="location_dest_id"/>
                        </list>
                    </field>
                    <footer>
                        <button name="action_validate" type="object"
                                string="Validate &amp; Print" class="btn-primary"/>
                        <button special="cancel" string="Cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_wms_scan_receipt" model="ir.actions.act_window">
            <field name="name">Scan Receipt</field>
            <field name="res_model">wms.scan.receipt</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
