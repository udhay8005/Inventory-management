<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_wms_barcode_alias_tree" model="ir.ui.view">
            <field name="name">wms.barcode.alias.list</field>
            <field name="model">wms.barcode.alias</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="barcode"/>
                    <field name="product_id"/>
                    <field name="units_per_scan"/>
                    <field name="note"/>
                </list>
            </field>
        </record>

        <record id="action_wms_barcode_alias" model="ir.actions.act_window">
            <field name="name">Carton barcodes</field>
            <field name="res_model">wms.barcode.alias</field>
            <field name="view_mode">list</field>
        </record>
    </data>
</odoo>
