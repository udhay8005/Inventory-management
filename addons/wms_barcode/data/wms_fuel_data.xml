<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for the fuel-log name (FUEL-00001, ...). noupdate guards
             the running counter from a re-install reset. -->
        <record id="seq_wms_fuel_log" model="ir.sequence">
            <field name="name">WMS Fuel Log</field>
            <field name="code">wms.fuel.log</field>
            <field name="prefix">FUEL-</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="implementation">no_gap</field>
        </record>
    </data>
</odoo>
