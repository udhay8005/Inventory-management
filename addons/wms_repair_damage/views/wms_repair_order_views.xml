<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_wms_repair_form" model="ir.ui.view">
            <field name="name">wms.repair.order.form</field>
            <field name="model">wms.repair.order</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_start_repair" type="object"
                                string="Start Repair" class="btn-primary"
                                invisible="state != 'draft'"/>
                        <button name="action_finish_repair" type="object"
                                string="Mark Done" class="btn-primary"
                                invisible="state != 'in_repair'"/>
                        <button name="action_scrap" type="object"
                                string="Scrap"
                                invisible="state != 'in_repair'"/>
                        <button name="action_cancel" type="object"
                                string="Cancel"
                                invisible="state != 'draft'"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,in_repair,done"/>
                    </header>
                    <sheet>
                        <h1><field name="name" readonly="1"/></h1>
                        <group>
                            <group string="What &amp; where">
                                <field name="product_id"/>
                                <field name="quantity"/>
                                <field name="original_slot_id"/>
                                <field name="return_slot_id"
                                       placeholder="Defaults to original slot"/>
                                <field name="warehouse_id" readonly="1"/>
                                <field name="technician_id"/>
                                <field name="damage_id"
                                       invisible="not damage_id"/>
                                <field name="start_picking_id" readonly="1"
                                       invisible="not start_picking_id"/>
                                <field name="finish_picking_id" readonly="1"
                                       invisible="not finish_picking_id"/>
                            </group>
                            <group string="Who reported it">
                                <field name="wms_reported_by"
                                       placeholder="Worker who flagged the item"/>
                                <field name="wms_authorized_by"
                                       placeholder="Manager / cow-care lead"/>
                                <field name="wms_storekeeper_id"
                                       options="{'no_create': True, 'no_open': True}"
                                       placeholder="On-duty Store Keeper"/>
                            </group>
                        </group>
                        <field name="repair_notes" placeholder="What was wrong, what was done, parts used..."/>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_wms_repair_list" model="ir.ui.view">
            <field name="name">wms.repair.order.list</field>
            <field name="model">wms.repair.order</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="product_id"/>
                    <field name="quantity"/>
                    <field name="state"/>
                    <field name="technician_id"/>
                    <field name="wms_storekeeper_id" optional="show"/>
                    <field name="wms_reported_by" optional="hide"/>
                    <field name="wms_authorized_by" optional="hide"/>
                    <field name="create_date"/>
                </list>
            </field>
        </record>

        <record id="action_wms_repair" model="ir.actions.act_window">
            <field name="name">Repair orders</field>
            <field name="res_model">wms.repair.order</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
