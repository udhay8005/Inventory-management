[flake8]
max-line-length = 100
extend-ignore =
    E203,
    W503,
    E501
exclude =
    .git,
    .venv,
    venv,
    docs,
    backups,
    __pycache__,
    migrations
per-file-ignores =
    # Odoo manifests use Python literal syntax with no imports.
    __manifest__.py:E501
    # Test files often import without using.
    tests/__init__.py:F401
    # Odoo addon __init__ uses relative imports only.
    addons/*/__init__.py:F401
    addons/*/models/__init__.py:F401
    addons/*/wizards/__init__.py:F401
    addons/*/reports/__init__.py:F401
    addons/*/controllers/__init__.py:F401
