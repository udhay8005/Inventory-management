# Copy to .env and edit. Never commit .env.
# Read by scripts/install-native.ps1 to seed the Postgres role + Odoo config.

# ── Database ─────────────────────────────────────────────────────────────
# Password to set on the local 'odoo' Postgres role + write into
# config/odoo.native.conf. Pick something stronger than the default.
DB_USER=odoo
DB_PASSWORD=changeme_strong_password

# ── Odoo ─────────────────────────────────────────────────────────────────
ODOO_PORT=8069
# Master password for /web/database/manager (drop / restore / duplicate).
# The web UI itself is OFF (list_db=False in odoo.native.conf), so this
# only matters when running odoo-bin directly for restore / migration.
# Generate with: -join ((1..32) | % { '{0:x}' -f (Get-Random -Min 0 -Max 16) })
ODOO_ADMIN_PASSWD=changeme_master_password
ODOO_DB=wms

# ── Backup encryption ────────────────────────────────────────────────────
# scripts/backup-native.ps1 pipes pg_dump through GPG symmetric encryption.
# Without the passphrase the *.sql.gpg files cannot be restored. Store
# this somewhere safe OFF the server (password manager, sealed envelope).
# Losing it = losing the backups. Choose 24+ characters, no whitespace.
BACKUP_PASSPHRASE=changeme_backup_passphrase

# ── Optional AI worker (out-of-process forecast runner) ──────────────────
# Read by scripts/start-ai-worker.ps1. The worker connects to Odoo as
# ODOO_USER and retrains forecasts every FORECAST_INTERVAL_HOURS hours.
ODOO_USER=admin
ODOO_USER_PASSWORD=admin
FORECAST_INTERVAL_HOURS=6

# ── Optional Cloudflare named tunnel (permanent HTTPS URL) ────────────────
# Read by scripts/start-tunnel.ps1 in -Mode Named. Get a token at
# https://one.dash.cloudflare.com -> Networks -> Tunnels -> Create.
# Leave blank if you only use Quick tunnels (random trycloudflare.com URL).
CLOUDFLARE_TUNNEL_TOKEN=
