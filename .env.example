# Copy to .env and edit. Never commit .env.
# Read by scripts/install-native.ps1 to seed the Postgres role + Odoo config.
#
# SECURITY POLICY: any value left as a "changeme*" placeholder, or set to
# 'admin' / 'password' / 'local_master_pw' / similar, is detected as a
# placeholder by install-native.ps1 and AUTO-REPLACED with a 32-char
# cryptographically random value (then written back to .env, with the
# previous file preserved as .env.bak-<timestamp>). Setting a real
# strong password here means the installer uses YOUR value; leaving the
# placeholder means the installer picks one for you.

# ── Database ─────────────────────────────────────────────────────────────
# Password for the local 'odoo' Postgres role + config/odoo.native.conf.
# Must be 16+ chars from [A-Za-z0-9._-] (no quotes, no whitespace, no
# shell metacharacters -- enforced by install-native.ps1).
DB_USER=odoo
DB_PASSWORD=changeme_strong_password

# ── Odoo ─────────────────────────────────────────────────────────────────
ODOO_PORT=8069
# Master password for odoo-bin restore / duplicate / drop. The web UI
# database manager is HARD-DISABLED (list_db=False + db_listing=False in
# odoo.native.conf), so this is needed only for CLI restore. Generate
# with: -join ((1..32) | %% { '{0:x}' -f (Get-Random -Min 0 -Max 16) })
ODOO_ADMIN_PASSWD=changeme_master_password
ODOO_DB=wms

# ── Backup encryption ────────────────────────────────────────────────────
# scripts/backup-native.ps1 pipes pg_dump through GPG symmetric encryption.
# Without the passphrase the *.dump.gpg files cannot be restored. Store
# this somewhere safe OFF the server (password manager, sealed envelope).
# Losing it = losing the backups. Choose 24+ characters, no whitespace.
BACKUP_PASSPHRASE=changeme_backup_passphrase

# ── Optional AI worker (out-of-process forecast runner) ──────────────────
# Read by scripts/start-ai-worker.ps1. The worker MUST run as a dedicated
# low-privilege Odoo service user -- NEVER admin -- because its XML-RPC
# calls inherit that user's permissions. Create the user in Odoo
# (Settings -> Users) with just stock.move read + wms.forecast write.
# Both placeholders below will be rejected at startup; replace them with
# real values before running scripts/start-ai-worker.ps1.
ODOO_USER=svc_ai_forecast
ODOO_USER_PASSWORD=changeme_ai_worker_password
FORECAST_INTERVAL_HOURS=6

# ── Optional Cloudflare named tunnel (permanent HTTPS URL) ────────────────
# Read by scripts/start-tunnel.ps1 in -Mode Named. Get a token at
# https://one.dash.cloudflare.com -> Networks -> Tunnels -> Create.
# Leave blank if you only use Quick tunnels (random trycloudflare.com URL).
CLOUDFLARE_TUNNEL_TOKEN=
