# Force LF line endings for all text files in the repo.
# Without this, Windows developers' CRLF endings can creep into commits
# and trip up black / flake8 / Odoo XML parsers on Linux CI runners.

* text=auto eol=lf

*.py    text eol=lf
*.xml   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.csv   text eol=lf
*.sh    text eol=lf
Makefile text eol=lf

# Binary files — never normalize
*.png   binary
*.jpg   binary
*.pdf   binary
*.zip   binary
*.tar.gz binary
*.dump  binary
